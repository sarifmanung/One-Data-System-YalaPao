# Copy this template to a private staging secret file outside the repository.
# Do not commit the copied file or real credentials.
ONEDATA_TARGET_API_IMAGE=ghcr.io/example/onedata-api:staging-commit
ONEDATA_TARGET_WEB_IMAGE=ghcr.io/example/onedata-web:staging-commit
APP_VERSION=staging-commit
ONEDATA_TARGET_DATABASE_URL=mysql://onedata:replace-with-staging-password@staging-db:3306/one_data_target
ONEDATA_PUBLIC_WEB_URL=https://onedata-staging.example.org
SPECIAL_ALLOWANCES_BASE_URL=https://special-staging.example.org
SPECIAL_ALLOWANCES_INTEGRATION_TOKEN=replace-with-staging-integration-token
PORTAL_TOKEN_ISSUER=yala-pao-health-portal-staging
PORTAL_TOKEN_AUDIENCE=one_data_staging
PORTAL_SHARED_SECRET=replace-with-at-least-32-character-staging-secret
ONEDATA_TRUST_PROXY=10.0.0.0/8

# The staging overlay enforces these values; keep them explicit in the secret
# file as an additional review signal.
ONEDATA_DEV_AUTH_ENABLED=false
ONEDATA_ALLOW_PROVISIONAL_LEAVE_RULES=false
ONEDATA_SESSION_COOKIE_SECURE=true
ONEDATA_CSRF_REQUIRE_ORIGIN=true
ONEDATA_RATE_LIMIT_ENABLED=true
ONEDATA_METRICS_ENABLED=true
ONEDATA_WORKER_ENABLED=false
ONEDATA_LEAVE_SNAPSHOT_MONTHLY_ENABLED=false
