APP_NAME="One Data System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

ONEDATA_PORT=8088
ONEDATA_DB_PORT=13306
ONEDATA_DB_DATABASE=onedata
ONEDATA_DB_USERNAME=onedata
ONEDATA_DB_PASSWORD=change-this-local-password
ONEDATA_DB_ROOT_PASSWORD=change-this-local-root-password
ONEDATA_SEED_ADMIN_PASSWORD=change-this-local-password

ONEDATA_DEFAULT_AFFILIATION_CODE=YALA-PAO
ONEDATA_LOCAL_LOGIN_ENABLED=true
ONEDATA_SCHEDULED_MASTER_SYNC=false
ONEDATA_PORTAL_AUDIENCE=one_data
ONEDATA_PORTAL_ISSUER=
PORTAL_SHARED_SECRET=

SPECIAL_ALLOWANCES_BASE_URL=
SPECIAL_ALLOWANCES_INTEGRATION_TOKEN=
# Target NestJS adapter: the checked-in Special DTO currently accepts 1.0.
SPECIAL_ALLOWANCES_LEAVE_CONTRACT_VERSION=1.0
SPECIAL_ALLOWANCES_TIMEOUT=15
SPECIAL_ALLOWANCES_DRY_RUN=true

# Target local real-data shadow run only (never commit the actual token).
# On macOS, a Special-Allowances container exposed on host port 3010 is reachable
# from the target API container at http://host.docker.internal:3010.
# SPECIAL_ALLOWANCES_BASE_URL=http://host.docker.internal:3010
# SPECIAL_ALLOWANCES_INTEGRATION_TOKEN=<read from local secret source>
# Set ONEDATA_DEV_WORKSPACE_* to a target tenant created by the master-data sync
# and ONEDATA_DEV_EMPLOYEE_ID to a target employee id when testing a real user.

# Target NestJS/Next.js background worker (disabled by default).
ONEDATA_PROCESS_ROLE=api
ONEDATA_SESSION_IDLE_TIMEOUT_SECONDS=1800
ONEDATA_CSRF_ENABLED=true
ONEDATA_CSRF_REQUIRE_ORIGIN=false
ONEDATA_RATE_LIMIT_ENABLED=true
ONEDATA_AUTH_RATE_LIMIT_PER_MINUTE=20
ONEDATA_MUTATION_RATE_LIMIT_PER_MINUTE=120
ONEDATA_WORKER_ENABLED=false
ONEDATA_WORKER_MODE=ALL
ONEDATA_WORKER_INTERVAL_MS=60000
ONEDATA_WORKER_BATCH_SIZE=10
ONEDATA_WORKER_ID=onedata-worker
ONEDATA_LEAVE_SNAPSHOT_MONTHLY_ENABLED=false
ONEDATA_LEAVE_SNAPSHOT_CUTOFF_DAYS=3
# Development convenience only. Production must keep this false and publish
# an effective-dated HR-approved leave rulebook before calculating leave days.
ONEDATA_ALLOW_PROVISIONAL_LEAVE_RULES=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
