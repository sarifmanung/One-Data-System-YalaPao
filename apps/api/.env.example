NODE_ENV=development
PORT=3100
APP_VERSION=0.1.0
CORS_ORIGIN=http://localhost:3101
DATABASE_URL=mysql://onedata:change-me@localhost:13307/one_data_target

# Special-Allowances master-data projection. Leave empty until the service
# endpoint and a dedicated integration token are provisioned.
SPECIAL_ALLOWANCES_BASE_URL=
SPECIAL_ALLOWANCES_INTEGRATION_TOKEN=
SPECIAL_ALLOWANCES_TIMEOUT_MS=10000
# The checked-in Special-Allowances DTO currently validates 1.0; coordinate
# both systems before changing this to the target contract version.
SPECIAL_ALLOWANCES_LEAVE_CONTRACT_VERSION=1.0
ONEDATA_AFFILIATION_ID=affiliation-yala-pao
ONEDATA_AFFILIATION_SOURCE_ID=yala-pao
ONEDATA_AFFILIATION_CODE=YALA-PAO
ONEDATA_AFFILIATION_NAME=องค์การบริหารส่วนจังหวัดยะลา

# Portal SSO verification. Keep empty until the shared secret is provisioned.
PORTAL_TOKEN_ISSUER=yala-pao-health-portal
PORTAL_TOKEN_AUDIENCE=one_data
PORTAL_SHARED_SECRET=

# One Data local session. Raw session tokens are never stored in the database.
ONEDATA_SESSION_COOKIE=onedata_session
ONEDATA_SESSION_TTL_SECONDS=28800
# ONEDATA_SESSION_COOKIE_SECURE=false # local HTTP only; leave unset for production HTTPS
ONEDATA_SESSION_COOKIE_SAME_SITE=lax
# ONEDATA_SESSION_COOKIE_DOMAIN=

# Explicit local-only test switch. Must remain false outside local development.
ONEDATA_DEV_AUTH_ENABLED=false
ONEDATA_DEV_ROLE=DEVELOPMENT_ONLY
ONEDATA_DEV_PERMISSIONS=
# Optional local-only workspace override for integration smoke tests.
# ONEDATA_DEV_WORKSPACE_KIND=affiliation
# ONEDATA_DEV_WORKSPACE_ID=affiliation-dev

# Optional background worker. Keep disabled until schedule/cutover is approved.
ONEDATA_WORKER_ENABLED=false
ONEDATA_WORKER_MODE=ALL
ONEDATA_WORKER_INTERVAL_MS=60000
ONEDATA_WORKER_BATCH_SIZE=10
ONEDATA_WORKER_ID=onedata-worker
ONEDATA_LEAVE_SNAPSHOT_MONTHLY_ENABLED=false
# ONEDATA_LEAVE_SNAPSHOT_PERIOD=2026-08
# ONEDATA_LEAVE_SNAPSHOT_AFFILIATION_ID=affiliation-id
# ONEDATA_LEAVE_SNAPSHOT_SOURCE_CUTOFF=2026-09-03T23:59:59.999Z
ONEDATA_LEAVE_SNAPSHOT_CUTOFF_DAYS=3
