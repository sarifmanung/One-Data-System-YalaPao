NODE_ENV=development
PORT=3100
APP_VERSION=0.1.0
CORS_ORIGIN=http://localhost:3101
DATABASE_URL=mysql://onedata:change-me@localhost:13307/one_data_target

# Portal SSO verification. Keep empty until the shared secret is provisioned.
PORTAL_TOKEN_ISSUER=yala-pao-health-portal
PORTAL_TOKEN_AUDIENCE=one_data
PORTAL_SHARED_SECRET=

# One Data local session. Raw session tokens are never stored in the database.
ONEDATA_SESSION_COOKIE=onedata_session
ONEDATA_SESSION_TTL_SECONDS=28800
# ONEDATA_SESSION_COOKIE_SECURE=false # local HTTP only; leave unset for production HTTPS
ONEDATA_SESSION_COOKIE_SAME_SITE=lax
# ONEDATA_SESSION_COOKIE_DOMAIN=

# Explicit local-only test switch. Must remain false outside local development.
ONEDATA_DEV_AUTH_ENABLED=false
ONEDATA_DEV_ROLE=DEVELOPMENT_ONLY
